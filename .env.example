# --- Required ---

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Optional: tracing ---

# LangSmith — https://smith.langchain.com
# Worth turning on here: a supervisor turn is a tree of agent runs, and a trace
# is the only place you can see what each sub-agent was actually asked.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supervisor-agent
